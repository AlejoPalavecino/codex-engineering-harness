# Go checksums and source must remain LF on Windows for reproducible module verification.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Identical fixture/catalog bytes and SHA-256 across operating systems.
evals/** text eol=lf
tests/fixtures/** text eol=lf

# Preserve exact bytes of pinned third-party skills and their manifests.
skills/diagram-design/** -text
skills/frontend-design/** -text
